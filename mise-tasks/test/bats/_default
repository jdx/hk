#!/usr/bin/env bash
#MISE alias="tb"
#MISE depends=["build", "test:bats:setup"]

# Runs the bats suite in the three git-backend modes. Needs bats, ripgrep (rg)
# and GNU parallel on PATH; scripts/run-bats checks for them and fails when a
# path matches no test or no test ran. Pass several files as separate arguments:
#   mise run test:bats test/check.bats test/fix.bats

set -eu

mise run test:bats:libgit2 "$@" ::: test:bats:nolibgit2 "$@" ::: test:bats:nogit "$@"
