#!/usr/bin/env bash
#MISE description="Render the shanty's music video to docs/public/bound-for-the-main.mp4 with its poster"
#MISE dir="docs"
# The shanty's page plays this video and offers it as og:video for link
# previews. Needs ffmpeg on PATH and Playwright's Chromium headless shell
# (`aube exec playwright-core install chromium-headless-shell` in docs/), or a
# Chromium-based browser at CHROME_PATH. Builds without it play the song alone.
# Not a render:* task: `mise run render` runs those, and CI fails on the diff.

set -eu

aube install && aube run shanty:video
