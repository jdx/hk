import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Elixir"
  description = "Compile Elixir with Mix"
}
mix_compile = new Config.Step {
  glob = "**/*.ex"
  exclude = List("deps/**/*")
  check = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("mix", "compile", "--warnings-as-errors", "--strict-errors", "{{files}}")
    }
    effect = "write"
  }
}
