import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Go"
  description = "Go static analysis"
}
staticcheck = new Config.Step {
  glob = "**/*.go"
  workspace_indicator = "go.mod"
  check = new Config.CommandSpec {
    command = "cd {{workspace}} && staticcheck ./..."
    effect = "write"
  }
}
