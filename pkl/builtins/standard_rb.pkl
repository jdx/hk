import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Ruby"
  description = "Ruby Standard Style"
  project_indicators {
    new { file = "Gemfile"; contains = "standard" }
  }
  mise_tools = List("gem:standard")
}
standard_rb = new Config.Step {
  types = List("ruby")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("standardrb", "--force-exclusion", "{{files}}") }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("standardrb", "--force-exclusion", "--fix", "{{files}}")
    }
    effect = "write"
  }
  tests {
    local const bad = "puts( 'hello' )\n"
    local const good = "puts(\"hello\")\n"
    local const testMaker = new helpers.TestMaker {
      filename = "app.rb"
      files = List("db/schema.rb", "app.rb")
      extra_files {
        [".standard.yml"] = "ignore:\n  - 'db/schema.rb'\n"
        ["db/schema.rb"] = bad
      }
    }
    ["check explicitly selected excluded file"] = (testMaker.checkPass(bad)) {
      files = List("db/schema.rb")
      expect { files { ["db/schema.rb"] = bad } }
    }
    ["check non-excluded bad file"] = (testMaker.checkFail(bad, 1)) {
      expect { files { ["db/schema.rb"] = bad } }
    }
    ["fix only non-excluded bad file"] = (testMaker.fixPass(bad, good)) {
      expect { files { ["db/schema.rb"] = bad } }
    }
  }
}
