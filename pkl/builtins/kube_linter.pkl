import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Infrastructure"
  description = "Check Kubernetes manifests for security and reliability issues"
  project_indicators {
    new { file = ".kube-linter.yaml" }
    new { file = ".kube-linter.yml" }
  }
}
// Select plain manifests in conventional directories, not arbitrary YAML such as
// GitHub workflows. Override glob for other layouts. Helm templates need to be
// rendered or linted as a chart separately, not passed as standalone YAML files.
// KubeLinter discovers .kube-linter.yaml or .kube-linter.yml in the working directory.
// Unlike kubeconform, this checks deployment policy, not Kubernetes schemas.
kube_linter = new Config.Step {
  glob =
    List(
      "**/k8s/**/*.yaml",
      "**/k8s/**/*.yml",
      "**/kubernetes/**/*.yaml",
      "**/kubernetes/**/*.yml",
      "**/manifests/**/*.yaml",
      "**/manifests/**/*.yml",
      "**/deploy/**/*.yaml",
      "**/deploy/**/*.yml",
      "**/deployments/**/*.yaml",
      "**/deployments/**/*.yml",
    )
  exclude =
    List(
      "**/templates/**",
      "**/values.yaml",
      "**/values.yml",
      "**/kustomization.yaml",
      "**/kustomization.yml",
    )
  // Keep selected resources together for checks involving related objects.
  // Use --all when those checks need unchanged related manifests too.
  // Reject malformed or empty manifest inputs rather than silently passing them.
  check = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("kube-linter", "lint", "--fail-if-no-objects-found", "{{files}}")
    }
    effect = "read"
  }
  tests {
    local const good =
      """
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: example
      data:
        key: value
      """
    local const bad =
      """
      apiVersion: v1
      kind: Pod
      metadata:
        name: example
      spec:
        containers:
          - name: app
            image: nginx:latest
      """
    local const testMaker = new helpers.TestMaker { filename = "k8s/resource.yaml" }
    ["check good manifest"] = testMaker.checkPass(good)
    ["check unsafe pod"] = testMaker.checkFail(bad, 1)
    ["check malformed manifest"] = testMaker.checkFail("apiVersion: v1\nkind: Pod\nspec: [\n", 1)
    ["check empty manifest"] = testMaker.checkFail("# no resources\n", 1)
    ["check nested manifest with spaces"] =
      testMaker.withFilename("services/app/k8s/my resource.yml").checkFail(bad, 1)
    ["check native configuration"] =
      (
        new helpers.TestMaker {
          filename = "k8s/resource.yaml"
          extra_files = new Mapping<String, String> {
            [".kube-linter.yaml"] =
              """
              checks:
                doNotAutoAddDefaults: true
                include:
                  - latest-tag
              """
          }
        }
      ).checkPass(bad.replaceAll("nginx:latest", "nginx:1.27"))
    ["check selected files only"] = new Config.StepTest {
      tmpdir = true
      files = List("k8s/good.yaml")
      write = new Mapping<String, String> {
        ["k8s/good.yaml"] = good
        ["k8s/bad.yaml"] = bad
      }
      expect = new Config.StepTestExpect { code = 0 }
    }
    ["check excludes chart metadata and templates"] = new Config.StepTest {
      tmpdir = true
      write = new Mapping<String, String> {
        ["k8s/good.yaml"] = good
        ["k8s/values.yaml"] = bad
        ["k8s/kustomization.yaml"] = bad
        ["k8s/templates/pod.yaml"] = bad
        [".github/workflows/ci.yml"] = bad
      }
      expect = new Config.StepTestExpect { code = 0 }
    }
  }
}
