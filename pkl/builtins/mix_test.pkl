import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Elixir"
  description = "Test Elixir with Mix"
  mise_tools = List("elixir")
}
mix_test = new Config.Step {
  glob = List("**/*.ex", "**/*.exs")
  exclude = List("deps/**/*")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("mix", "test", "--warnings-as-errors", "{{files}}") }
    effect = "write"
  }
}
