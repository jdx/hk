import "../Builtins.pkl"
import "../Config.pkl"
import "./rubocop.pkl"

@Builtins.meta {
  category = "Ruby"
  description = "Ruby style guide (using RuboCop's --server mode)"
  project_indicators {
    new { file = "Gemfile" }
  }
}
rubocop_server = (rubocop.rubocop) {
  // `--server`: Use a long-lived RuboCop server process to speed up repeated invocations.
  check = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("rubocop", "--server", "--force-exclusion", "{{files}}")
    }
    effect = "write"
  }
  // `--format files`: Outputs one file per line and exits non-zero when offenses exist.
  // `--list-target-files` would list every target file and always exit zero, so hk would
  // never detect files needing fixes.
  check_list_files = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("rubocop", "--server", "--force-exclusion", "--format", "files", "{{files}}")
    }
    effect = "write"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("rubocop", "--server", "--force-exclusion", "--autocorrect", "{{files}}")
    }
    effect = "write"
  }
}
