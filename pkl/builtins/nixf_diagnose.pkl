import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Nix"
  description = "Nix linter based on libnixf"
  homepage = "https://github.com/inclyc/nixf-diagnose"
}
nixf_diagnose = new Config.Step {
  glob = "**/*.nix"
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("nixf-diagnose", "{{files}}") }
    effect = "read"
  }
}
