import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

/// Formats sh, bash, mksh, bats and zsh files.
///
/// shfmt picks each file's dialect from its extension, shebang or name. zsh files need shfmt
/// 3.13.1 or newer, and 3.14 or newer to recognize every zsh startup file such as `.zlogout`;
/// older versions fail to parse zsh, or skip dotfiles such as `.zshrc` without reporting them.
@Builtins.meta {
  category = "Shell"
  description = "Shell formatter"
  project_indicators {
    new { glob = "*.sh"; recursive = true }
  }
}
shfmt = new Config.Step {
  batch = true
  match_any =
    List(
      new Config.FileSelector {
        glob = List("**/*.sh", "**/*.bash", "**/*.mksh", "**/*.bats", "**/*.zsh")
      },
      new Config.FileSelector { types = List("sh", "bash", "zsh") },
    )
  check_diff = new Config.CommandSpec {
    command = "shfmt -d --apply-ignore {{ files }}"
    effect = "read"
  }
  check_list_files = new Config.CommandSpec {
    command =
      """
      files=$(shfmt -l --apply-ignore {{ files }})
      if [ -n "$files" ]; then
      echo "$files"
      exit 1
      fi
      """
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = "shfmt -w --apply-ignore {{ files }}"
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker { filename = "test.sh" }
    local const before =
      """
      foo() {
        (( $bar ))
      }
      """ + "\n"
    local const after =
      """
      foo() {
      	(($bar))
      }
      """ + "\n"
    ["check bad file"] = testMaker.checkFail(before, 1)
    ["check good file"] = testMaker.checkPass(after)
    ["fix bad file"] = testMaker.fixPass(before, after)
    ["diff bad file"] = testMaker.diffPass(before, after)
    ["fix good file"] = testMaker.fixPass(after, after)

    local const extensionlessTestMaker = new helpers.TestMaker {
      filename = "script"
      files = List("script")
    }
    ["check extensionless shell script"] =
      extensionlessTestMaker.checkFail(
        "#!/bin/sh\n" + before,
        1,
      )

    // Parameter expansion flags are zsh-only, so these fail if shfmt parses the file as bash.
    // The files are not listed explicitly, so the step's filters must select them.
    local const zshBefore =
      """
      foo() {
        print ${(j:,:)arr}
      }
      """ + "\n"
    local const zshAfter =
      """
      foo() {
      	print ${(j:,:)arr}
      }
      """ + "\n"
    local const zshrcTestMaker = new helpers.TestMaker { filename = ".zshrc" }
    ["check zsh startup file"] = zshrcTestMaker.checkFail(zshBefore, 1)
    ["fix zsh startup file"] = zshrcTestMaker.fixPass(zshBefore, zshAfter)

    // The test runner filters files before writing them, so it cannot detect a type from a
    // shebang; list the script explicitly.
    local const zshScriptTestMaker = new helpers.TestMaker {
      filename = "script"
      files = List("script")
    }
    ["check extensionless zsh script"] = zshScriptTestMaker.checkFail("#!/bin/zsh\n" + zshBefore, 1)
    ["fix extensionless zsh script"] =
      zshScriptTestMaker.fixPass("#!/bin/zsh\n" + zshBefore, "#!/bin/zsh\n" + zshAfter)

    local const ignoredTestMaker = new helpers.TestMaker {
      filename = "test.sh"
      extra_files {
        [".editorconfig"] =
          """
          [test.sh]
          ignore = true
          """
      }
    }
    ["check ignored bad file"] = ignoredTestMaker.checkPass(before)
    ["check ignored good file"] = ignoredTestMaker.checkPass(after)
    ["fix ignored bad file"] = ignoredTestMaker.fixPass(before, before)
    ["fix ignored good file"] = ignoredTestMaker.fixPass(after, after)
  }
}
