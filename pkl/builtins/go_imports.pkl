import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Go"
  description = "Go import management"
}
go_imports = new Config.Step {
  glob = "**/*.go"
  check = new Config.CommandSpec {
    command = "goimports -l {{ files }}"
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = "goimports -w {{ files }}"
    effect = "write"
  }
}
