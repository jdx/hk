import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Python"
  description = "Python code analysis"
  project_indicators {
    new { file = ".pylintrc" }
    new { file = "pylintrc" }
    new { file = "pyproject.toml"; contains_regex = #"^\[tool\.pylint[\].]"# }
  }
}
pylint = new Config.Step {
  glob = "**/*.py"
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("pylint", "{{files}}") }
    effect = "write"
  }
}
