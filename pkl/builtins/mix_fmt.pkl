import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Elixir"
  description = "Format Elixir with Mix"
}
mix_fmt = new Config.Step {
  glob = List("**/*.ex", "**/*.exs")
  exclude = List("deps/**/*")
  check = new Config.CommandSpec {
    command = "mix format --check-formatted {{files}}"
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = "mix format {{files}}"
    effect = "write"
  }
}
