import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Nix"
  description = "Nix formatter"
  homepage = "https://github.com/NixOS/nixfmt"
}
nix_fmt = new Config.Step {
  glob = "**/*.nix"
  check = new Config.CommandSpec {
    command = new Config.Script {
      windows = ""
      other = "nixfmt --check {{ files }}"
    }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Script {
      windows = ""
      other = "nixfmt {{ files }}"
    }
    effect = "write"
  }
}
