import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "JavaScript/TypeScript"
  description = "Deno type checker"
  project_indicators {
    new { file = "deno.json" }
    new { file = "deno.jsonc" }
  }
  mise_tools = List("deno")
}
deno_check = new Config.Step {
  glob = List("**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("deno", "check", "{{files}}") }
    effect = "write"
  }
}
