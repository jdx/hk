import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

class PinactStep extends Config.Step {
  hidden version: "3" | "4" = "4"
  glob = List(".github/workflows/*", "**/action.*")
  types = List("yaml")
  // `verify-comment` verifies pairs of commit SHA and version comments are correct
  hidden verifyFlag = if (version == "3") "--verify" else "--verify-comment"
  check = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("pinact", "run", verifyFlag, "--check", "{{files}}")
    }
    effect = "read"
  }
  // pinact's report is not a patch, but its SARIF report carries fixes, which
  // `hk util sarif-diff` turns into one. A finding without a fix, such as a
  // version comment that doesn't match its SHA, prints no patch, so hk runs
  // the fixer and reports what it leaves behind.
  check_diff = new Config.CommandSpec {
    command = new Config.Command {
      argv =
        List(
          "hk",
          "util",
          "sarif-diff",
          "--",
          "pinact",
          "run",
          verifyFlag,
          "--check",
          "--format",
          "sarif",
          "{{files}}",
        )
    }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("pinact", "run", verifyFlag, "{{files}}") }
    effect = "write"
  }
  tests =
    if (version == "3")
      new Mapping<String, Config.StepTest> {
        local const testMaker = new helpers.TestMaker {
          before = "pinact init"
          filename = ".github/workflows/test.yml"
        }
        // Unlike v4, v3 reports a mismatched version comment but does not repair it.
        ["fix bad file and mismatched version comment"] =
          testMaker.fixFail(
            """
            name: pinact test
            on:
              push:
            jobs:
              build:
                runs-on: ubuntu-latest
                steps:
                  - uses: actions/checkout@v6.0.1
                  - uses: jdx/mise-action@d16887ba50704baed7de72bd1e82e04391e4457a # v3.5.1

            """,
            """
            name: pinact test
            on:
              push:
            jobs:
              build:
                runs-on: ubuntu-latest
                steps:
                  - uses: actions/checkout@8e8c483db84b4bee98b60c0593521ed34d9990e8 # v6.0.1
                  - uses: jdx/mise-action@d16887ba50704baed7de72bd1e82e04391e4457a # v3.5.1

            """,
            1,
          )
      }
    else
      new Mapping<String, Config.StepTest> {
        local const bad =
          """
          name: pinact test
          on:
            push:
          jobs:
            test:
              runs-on: ubuntu-latest
              steps:
                - uses: actions/checkout@v6.0.1

          """
        local const good =
          """
          name: pinact test
          on:
            push:
          jobs:
            test:
              runs-on: ubuntu-latest
              steps:
                - uses: actions/checkout@8e8c483db84b4bee98b60c0593521ed34d9990e8 # v6.0.1

          """
        local const testMaker = new helpers.TestMaker {
          before = "pinact init" // create the pinact configuration file
          filename = ".github/workflows/test.yml"
        }
        ["check bad file"] = testMaker.checkFail(bad, 1)
        ["check good file"] = testMaker.checkPass(good)
        ["fix bad file and mismatched version comment"] =
          testMaker.fixPass(
            """
            name: pinact test
            on:
              push:
            jobs:
              build:
                runs-on: ubuntu-latest
                steps:
                  - uses: actions/checkout@v6.0.1
                  - uses: jdx/mise-action@d16887ba50704baed7de72bd1e82e04391e4457a # v3.5.1

            """,
            """
            name: pinact test
            on:
              push:
            jobs:
              build:
                runs-on: ubuntu-latest
                steps:
                  - uses: actions/checkout@8e8c483db84b4bee98b60c0593521ed34d9990e8 # v6.0.1
                  - uses: jdx/mise-action@d16887ba50704baed7de72bd1e82e04391e4457a # v3.5.0

            """,
          )
        ["fix bad file all violations are fixed"] = testMaker.fixPass(bad, good)
        ["fix good file"] = testMaker.fixPass(good, good)
      }
}

@Builtins.meta {
  category = "Infrastructure"
  description = "Pin GitHub Actions to commit SHA for security"
}
// Keep the exported type exactly Config.Step: pklr rejects a concrete subclass
// instance when it is inserted into Mapping<String, Config.Step>.
const pinact = (new PinactStep {}) as Config.Step
