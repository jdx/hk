import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "PHP"
  description = "PHP coding standards"
  project_indicators {
    new { file = "phpcs.xml" }
    new { file = "phpcs.xml.dist" }
    new { file = ".phpcs.xml" }
    new { file = ".phpcs.xml.dist" }
  }
}
php_cs = new Config.Step {
  glob = "**/*.php"
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("phpcs", "{{files}}") }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("phpcbf", "{{files}}") }
    effect = "write"
  }
}
