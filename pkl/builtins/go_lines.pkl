import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Go"
  description = "Long line fixer"
}
go_lines = new Config.Step {
  glob = "**/*.go"
  check = new Config.CommandSpec {
    command = "golines --dry-run {{ files }}"
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = "golines -w {{ files }}"
    effect = "write"
  }
}
