import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Data Formats"
  description = "YAML linter"
  mise_tools = List("yamllint")
}
yamllint = new Config.Step {
  glob = List("**/*.yml", "**/*.yaml")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("yamllint", "--strict", "{{files}}") }
    effect = "read"
  }
  // Off a terminal yamllint prints a path line, then `  line:col  level  message  (rule)` rows
  diagnostic_format = "stylish"
  tests {
    local const testMaker = new helpers.TestMaker { filename = "test.yaml" }
    ["check good file"] = testMaker.checkPass("---\nx: 1\n")
    ["check warning file"] = testMaker.checkFail("x: 1\n", 2)
    ["check error file"] = testMaker.checkFail("---\nx: 1\nx: 2\n", 1)
    ["check warning+error file"] = testMaker.checkFail("x: 1\nx: 2\n", 1)
    ["check error file reports diagnostics"] =
      testMaker.checkDiagnostics(
        "---\nx: 1\nx: 2\n",
        1,
        List(new Config.StepTestDiagnostic {
          path = "test.yaml"
          line = 3
          column = 1
          severity = "error"
          rule = "key-duplicates"
        }),
      )
  }
}
