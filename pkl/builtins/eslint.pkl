import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "JavaScript/TypeScript"
  description = "Pluggable JavaScript linter"
  project_indicators {
    new { file = "package.json"; contains = "\"eslint\"" }
    new { file = "eslint.config.js" }
    new { file = "eslint.config.mjs" }
    new { file = "eslint.config.cjs" }
    new { file = "eslint.config.ts" }
    new { file = "eslint.config.mts" }
    new { file = "eslint.config.cts" }
    new { file = ".eslintrc" }
    new { file = ".eslintrc.json" }
    new { file = ".eslintrc.yaml" }
    new { file = ".eslintrc.yml" }
    new { file = ".eslintrc.js" }
    new { file = ".eslintrc.cjs" }
  }
}
eslint = new Config.Step {
  glob = List("**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx")
  batch = true
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("eslint", "{{files}}") }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("eslint", "--fix", "{{files}}") }
    effect = "write"
  }
}
