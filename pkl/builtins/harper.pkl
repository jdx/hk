import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Special Purpose"
  description = "Grammar checker for prose and documentation"
}
harper = new Config.Step {
  types = List("text")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("harper-cli", "lint", "{{files}}") }
    effect = "read"
  }
  tests {
    local const testMaker = new helpers.TestMaker {
      filename = "foo.md"
    }
    ["check bad file"] = testMaker.checkFail("That;s", 1)
    ["check good file"] = testMaker.checkPass("That's")
  }
}
