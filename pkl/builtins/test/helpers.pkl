/// Helper for hk step tests
module hk.builtins.test.helpers

import "../../Config.pkl"

class TestMaker {
  /// The name of the file to run the command on.
  filename: String = "file.txt"

  /// Explicit files to pass to the command. Defaults to the written file keys.
  files: List<String>?

  /// Extra files to include in the sandbox, useful for config files.
  extra_files: Mapping<String, String> = new Mapping {}

  /// Extra environment variables for the test.
  env: Mapping<String, String> = new Mapping {}

  /// (Copied to the test)
  before: String?

  /// Make a config test
  local function makeTest(
    runType: String,
    contentBefore: String,
    contentAfter: String,
    expectedCode: Int,
  ): Config.StepTest = new Config.StepTest {
    run = runType
    files = outer.files
    before = outer.before
    env = outer.env
    tmpdir = true
    write = new Mapping<String, String> {
      [filename] = contentBefore
      ...extra_files
    }
    expect = new Config.StepTestExpect {
      code = expectedCode
      files = new Mapping<String, String> {
        [filename] = contentAfter
      }
    }
  }

  /// Make a "check" test (where `check` should exit zero)
  function checkPass(contents: String): Config.StepTest = makeTest("check", contents, contents, 0)

  /// Make a "check" test (where `check` should exit nonzero)
  function checkFail(contents: String, code: Int): Config.StepTest =
    makeTest("check", contents, contents, code)

  /// Make a "check" test (where `check` should exit nonzero) that also expects the step's
  /// `diagnostic_format` to parse its output into diagnostics matching each of `found`
  function checkDiagnostics(
    contents: String,
    code: Int,
    found: List<Config.StepTestDiagnostic>,
  ): Config.StepTest = (makeTest("check", contents, contents, code)) {
    expect {
      diagnostics { ...found }
    }
  }

  /// Make a "fix" test (where `fix` should exit zero)
  function fixPass(contentsBefore: String, contentsAfter: String): Config.StepTest =
    makeTest("fix", contentsBefore, contentsAfter, 0)

  /// Make a "fix" test (where `fix` should exit nonzero)
  function fixFail(contentsBefore: String, contentsAfter: String, code: Int): Config.StepTest =
    makeTest("fix", contentsBefore, contentsAfter, code)

  /// Make a "diff" test: `check_diff`'s patch must apply and produce `contentsAfter`
  function diffPass(contentsBefore: String, contentsAfter: String): Config.StepTest =
    makeTest("diff", contentsBefore, contentsAfter, 0)

  /// Make a "diff" test for a partial fixer, where `check` still fails after the patch applies
  function diffFail(contentsBefore: String, contentsAfter: String, code: Int): Config.StepTest =
    makeTest("diff", contentsBefore, contentsAfter, code)

  /// Make a TestMaker (same as this one) but using the provided filename
  function withFilename(newFilename: String): TestMaker = (this) {
    filename = newFilename
  }
}

/// Tests for a secret scanner's `scan = "commits"` mode, which scans every commit in the run's ref
/// range. `secret` is a string the scanner reports and `failCode` is its exit code on findings.
function commitScanTests(secret: String, failCode: Int): Mapping<String, Config.StepTest> =
  let (
    init =
      "git init --quiet -b main && git config user.email t@example.com && git config user.name t && git config commit.gpgsign false"
  )
  let (commit = (msg: String) -> "git add -A && git commit --quiet --allow-empty -m " + msg)
  let (addSecret = "printf '%s\\n' '" + secret + "' > s.txt")
  let (base = init + " && printf base > a.txt && " + commit.apply("base"))
    new Mapping<String, Config.StepTest> {
      ["commits: secret added then removed in range"] = new Config.StepTest {
        tmpdir = true
        before =
          base
            + " && "
            + addSecret
            + " && "
            + commit.apply("add")
            + " && git rm --quiet s.txt && "
            + commit.apply("remove")
        from_ref = "HEAD~2"
        expect { code = failCode }
      }
      ["commits: clean range"] = new Config.StepTest {
        tmpdir = true
        before = base + " && printf more > b.txt && " + commit.apply("more")
        from_ref = "HEAD~1"
      }
      ["commits: to_ref defaults to HEAD"] = new Config.StepTest {
        tmpdir = true
        before = base + " && " + addSecret + " && " + commit.apply("add")
        from_ref = "HEAD~1"
        expect { code = failCode }
      }
      ["commits: secret before from_ref is ignored"] = new Config.StepTest {
        tmpdir = true
        before =
          base
            + " && "
            + addSecret
            + " && "
            + commit.apply("add")
            + " && git rm --quiet s.txt && "
            + commit.apply("remove")
            + " && printf more > b.txt && "
            + commit.apply("more")
        from_ref = "HEAD~1"
      }
      ["commits: secret after to_ref is ignored"] = new Config.StepTest {
        tmpdir = true
        before =
          base
            + " && printf more > b.txt && "
            + commit.apply("more")
            + " && "
            + addSecret
            + " && "
            + commit.apply("add")
        from_ref = "HEAD~2"
        to_ref = "HEAD~1"
      }
      ["commits: no ref range fails"] = new Config.StepTest {
        tmpdir = true
        before = base
        expect {
          code = 1
          stderr = "needs a ref range"
        }
      }
    }
