import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Infrastructure"
  description = "OpenTofu configuration validator"
}
tofu_validate = new Config.Step {
  glob =
    List(
      "**/*.tf",
      "**/*.tfvars",
      "**/*.tf.json",
      "**/*.tofu",
      "**/*.tofu.json",
      "**/.terraform.lock.hcl",
    )
  exclude = "**/.terraform/**"
  check = new Config.CommandSpec {
    command =
      """
      for f in {{ files }}; do dirname "$f"; done | sort -u | { code=0; while IFS= read -r dir; do
      tofu -chdir="$dir" validate && continue
      tofu -chdir="$dir" init -backend=false -input=false > /dev/null || { code=1; continue; }
      tofu -chdir="$dir" validate || code=1
      done; exit $code; }
      """
    effect = "write"
  }
  tests {
    ["check valid module"] {
      run = "check"
      tmpdir = true
      write {
        ["main.tf"] =
          """
          variable "name" {
            type = string
          }

          output "name" {
            value = var.name
          }

          """
      }
      expect { code = 0 }
    }
    ["check undeclared reference"] {
      run = "check"
      tmpdir = true
      write {
        ["main.tf"] =
          """
          output "name" {
            value = var.undeclared
          }

          """
      }
      expect {
        code = 1
        stderr = "Reference to undeclared input variable"
      }
    }
    ["check undeclared reference in JSON"] {
      run = "check"
      tmpdir = true
      write {
        ["main.tf.json"] =
          """
          {"output": {"name": {"value": "${var.undeclared}"}}}
          """
      }
      expect {
        code = 1
        stderr = "Reference to undeclared input variable"
      }
    }
    ["check undeclared reference in OpenTofu JSON"] {
      run = "check"
      tmpdir = true
      write {
        ["main.tofu.json"] =
          """
          {"output": {"name": {"value": "${var.undeclared}"}}}
          """
      }
      expect {
        code = 1
        stderr = "Reference to undeclared input variable"
      }
    }
  }
}
