import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Python"
  description = "Python style guide enforcement"
}
flake8 = new Config.Step {
  glob = "**/*.py"
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("flake8", "{{files}}") }
    effect = "read"
  }
}
