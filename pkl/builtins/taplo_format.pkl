import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Data Formats"
  description = "TOML formatter"
}
taplo_format = new Config.Step {
  glob = "**/*.toml"
  env {
    // prevent logs to stderr with the list of checked files
    ["RUST_LOG"] = "warn"
  }
  // `--check --diff` output is colored and its hunks are malformed, so it is
  // the check. `check_diff` builds the patch from taplo's stdin mode, which
  // ignores the configuration's `exclude`, so it first asks `--check` which
  // files would change. The script needs a POSIX shell; on Windows hk runs the
  // fixer.
  check = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("taplo", "format", "--check", "--diff", "{{files}}")
    }
    effect = "read"
  }
  check_diff = new Config.CommandSpec {
    command = new Config.Script {
      windows = ""
      other =
        #"""
        out=$(taplo format --check --colors never {{ files }} 2>&1) && exit 0
        status=$?
        set --
        while IFS= read -r line; do
        case $line in
        *'not properly formatted path="'*)
          f=${line#*path=\"}
          set -- "$@" "${f%\"}"
          ;;
        esac
        done <<EOF
        $out
        EOF
        # Nothing listed means taplo failed for another reason, such as a
        # syntax error: print no patch, and the fixer reports it.
        if [ $# -eq 0 ]; then
        printf '%s\n' "$out" >&2
        exit $status
        fi
        hk util format-diff "$@" -- taplo format --colors never --stdin-filepath {} -
        """#
    }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("taplo", "format", "{{files}}") }
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker { filename = "test.toml" }
    ["check bad file"] = testMaker.checkFail("[table]\nkey  =  \"value\"\n", 1)
    ["check good file"] = testMaker.checkPass("[table]\nkey = \"value\"\n")
    ["fix bad file"] =
      testMaker.fixPass("[table]\nkey  =  \"value\"\n", "[table]\nkey = \"value\"\n")
    ["fix good file"] =
      testMaker.fixPass("[table]\nkey = \"value\"\n", "[table]\nkey = \"value\"\n")
  }
}
