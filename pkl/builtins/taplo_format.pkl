import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Data Formats"
  description = "TOML formatter"
}
taplo_format = new Config.Step {
  glob = "**/*.toml"
  env {
    // prevent logs to stderr with the list of checked files
    ["RUST_LOG"] = "warn"
  }
  // `--check --diff` output is colored and its hunks are malformed, so it is
  // the check. `check_diff` builds the patch from taplo's stdin mode, which
  // ignores the configuration's `exclude`, so it first asks `--check` about
  // each file: it exits 0 for one that is formatted or excluded. A file taplo
  // can't parse fails that check and then its stdin run, which prints no
  // patch, so hk runs the fixer and it reports the error. The script needs a
  // POSIX shell; on Windows hk runs the fixer.
  check = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("taplo", "format", "--check", "--diff", "{{files}}")
    }
    effect = "read"
  }
  check_diff = new Config.CommandSpec {
    command = new Config.Script {
      windows = ""
      other =
        #"""
        set --
        for f in {{ files }}; do
        taplo format --check --colors never "$f" > /dev/null 2>&1 || set -- "$@" "$f"
        done
        [ $# -eq 0 ] && exit 0
        hk util format-diff "$@" -- taplo format --colors never --stdin-filepath {} -
        """#
    }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("taplo", "format", "{{files}}") }
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker { filename = "test.toml" }
    ["check bad file"] = testMaker.checkFail("[table]\nkey  =  \"value\"\n", 1)
    ["check good file"] = testMaker.checkPass("[table]\nkey = \"value\"\n")
    ["fix bad file"] =
      testMaker.fixPass("[table]\nkey  =  \"value\"\n", "[table]\nkey = \"value\"\n")
    ["diff bad file"] =
      testMaker.diffPass("[table]\nkey  =  \"value\"\n", "[table]\nkey = \"value\"\n")
    ["fix good file"] =
      testMaker.fixPass("[table]\nkey = \"value\"\n", "[table]\nkey = \"value\"\n")
    // taplo's stdin mode ignores `exclude`, so the patch must leave out files
    // it excludes.
    local const excludeMaker = (testMaker) {
      extra_files { ["taplo.toml"] = "exclude = [\"test.toml\"]\n" }
    }
    ["diff respects config exclude"] =
      excludeMaker.diffPass("[table]\nkey  =  \"value\"\n", "[table]\nkey  =  \"value\"\n")
  }
}
