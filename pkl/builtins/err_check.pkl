import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Go"
  description = "Error handling checker"
}
err_check = new Config.Step {
  glob = "**/*.go"
  workspace_indicator = "go.mod"
  check = new Config.CommandSpec {
    command = "cd {{workspace}} && errcheck ./..."
    effect = "read"
  }
}
