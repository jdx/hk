import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

/// Lints GitHub Actions workflows, composite actions, and Dependabot configuration.
///
/// Requires jactionlint v2. `check` prints findings in jactionlint's gcc format, which hk parses
/// into diagnostics (path, line, column, rule). The fixes come from a second run: `check_diff`
/// asks jactionlint for its findings as SARIF (`--format sarif`), which carries the edit of every
/// mechanical fix, and `hk util sarif-diff` turns those edits into a patch. If any finding has no
/// fix, it prints no patch, so hk runs `jactionlint --fix` and reports what remains.
///
/// jactionlint runs the rules of its `default` profile. To also run the noisier opinionated
/// rules of the `pedantic` profile, or to get only what actionlint checks (`correctness`), set
/// `profile:` in `.github/jactionlint.yaml`; it applies to hk, CI, and editors alike. To choose
/// the profile only in hk.pkl, pass `--profile` to all three commands:
///
/// ```pkl
/// ["jactionlint"] = (Builtins.jactionlint) {
///   check { command { argv = List("jactionlint", "--profile", "pedantic", "--format", "gcc", "{{files}}") } }
///   check_diff { command { argv = List("hk", "util", "sarif-diff", "--", "jactionlint", "--profile", "pedantic", "--format", "sarif", "{{files}}") } }
///   fix { command { argv = List("jactionlint", "--profile", "pedantic", "--fix", "{{files}}") } }
/// }
/// ```
@Builtins.meta {
  category = "Infrastructure"
  description = "GitHub Actions workflow linter (jdx/jactionlint, a maintained actionlint fork)"
  mise_tools = List("jactionlint")
}
const jactionlint = new Config.Step {
  glob =
    List(
      ".github/workflows/*.y*ml",
      ".github/actions/**/action.y*ml",
      ".github/dependabot.y*ml",
    )
  batch = true
  // `path:line:column: severity: message [rule]`
  diagnostic_format = "gcc"
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("jactionlint", "--format", "gcc", "{{files}}") }
    effect = "read"
  }
  check_diff = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("hk", "util", "sarif-diff", "--", "jactionlint", "--format", "sarif", "{{files}}")
    }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("jactionlint", "--fix", "{{files}}") }
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker {
      filename = ".github/workflows/test.yml"
      before = "git init"
    }
    // Clean under jactionlint's default profile, which also wants a timeout, a concurrency group and
    // explicit permissions
    local const goodWorkflow =
      """
      on:
        push:
          branches: main
      concurrency:
        group: ${{ github.workflow }}-${{ github.ref }}
        cancel-in-progress: true
      permissions: {}
      jobs:
        test:
          runs-on: ubuntu-latest
          timeout-minutes: 5
          steps:
            - run: echo "Pass"

      """
    // A mistake with no fix: `branch` should be `branches`
    local const badWorkflow =
      """
      on:
        push:
          branch: main
      concurrency:
        group: ${{ github.workflow }}-${{ github.ref }}
        cancel-in-progress: true
      permissions: {}
      jobs:
        test:
          runs-on: ubuntu-latest
          timeout-minutes: 5
          steps:
            - run: echo "Pass"

      """
    // Its only finding is `missing-permissions`, which has a safe fix
    local const fixableWorkflow =
      """
      on:
        push:
          branches: main
      concurrency:
        group: ${{ github.workflow }}-${{ github.ref }}
        cancel-in-progress: true
      jobs:
        test:
          runs-on: ubuntu-latest
          timeout-minutes: 5
          steps:
            - run: echo "Pass"

      """
    local const fixedWorkflow =
      """
      on:
        push:
          branches: main

      permissions:
        contents: read
      concurrency:
        group: ${{ github.workflow }}-${{ github.ref }}
        cancel-in-progress: true
      jobs:
        test:
          runs-on: ubuntu-latest
          timeout-minutes: 5
          steps:
            - run: echo "Pass"

      """
    ["check bad file"] = testMaker.checkFail(badWorkflow, 1)
    ["check bad file reports diagnostics"] =
      testMaker.checkDiagnostics(
        badWorkflow,
        1,
        List(new Config.StepTestDiagnostic {
          path = ".github/workflows/test.yml"
          line = 3
          column = 5
          severity = "error"
          rule = "workflow-syntax"
          message = "unexpected key \"branch\""
        }),
      )
    ["check good file"] = testMaker.checkPass(goodWorkflow)
    // The patch comes from the fix in jactionlint's SARIF log, not from rerunning `--fix`.
    ["diff fixable file"] = testMaker.diffPass(fixableWorkflow, fixedWorkflow)
    ["fix fixable file"] = testMaker.fixPass(fixableWorkflow, fixedWorkflow)
  }
}
