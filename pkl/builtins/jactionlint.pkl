import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

/// Lints GitHub Actions workflows, composite actions, and Dependabot configuration.
///
/// Requires jactionlint v2, which reports rule IDs and fixes in SARIF (`--format sarif`) and
/// has `--fix`. `check_diff` turns the fixes in that log into a patch. If any finding has no
/// fix, it prints no patch, so hk runs `jactionlint --fix` and reports what remains.
///
/// jactionlint runs the rules of its `default` profile. To also run the noisier opinionated
/// rules of the `pedantic` profile, or to get only what actionlint checks (`correctness`), set
/// `profile:` in `.github/jactionlint.yaml`; it applies to hk, CI, and editors alike. To choose
/// the profile only in hk.pkl, pass `--profile` to all three commands:
///
/// ```pkl
/// ["jactionlint"] = (Builtins.jactionlint) {
///   check { command { argv = List("jactionlint", "--profile", "pedantic", "--format", "sarif", "{{files}}") } }
///   check_diff { command { argv = List("hk", "util", "sarif-diff", "--", "jactionlint", "--profile", "pedantic", "--format", "sarif", "{{files}}") } }
///   fix { command { argv = List("jactionlint", "--profile", "pedantic", "--fix", "{{files}}") } }
/// }
/// ```
@Builtins.meta {
  category = "Infrastructure"
  description = "GitHub Actions workflow linter (jdx/jactionlint, a maintained actionlint fork)"
}
const jactionlint = new Config.Step {
  glob =
    List(
      ".github/workflows/*.y*ml",
      ".github/actions/**/action.y*ml",
      ".github/dependabot.y*ml",
    )
  batch = true
  // `--format sarif` carries stable rule IDs, levels, regions and fixes
  diagnostic_format = "sarif"
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("jactionlint", "--format", "sarif", "{{files}}") }
    effect = "read"
  }
  check_diff = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("hk", "util", "sarif-diff", "--", "jactionlint", "--format", "sarif", "{{files}}")
    }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("jactionlint", "--fix", "{{files}}") }
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker {
      filename = ".github/workflows/test.yml"
      before = "git init"
    }
    local const badWorkflow =
      """
      on:
        push:
          branch: main
      jobs:
        test:
          runs-on: ubuntu-latest
          steps:
            - run: echo "Pass"

      """
    local const goodWorkflow =
      """
      on:
        push:
          branches: main
      jobs:
        test:
          runs-on: ubuntu-latest
          steps:
            - run: echo "Pass"

      """
    ["check bad file"] = testMaker.checkFail(badWorkflow, 1)
    // No diagnostics test: `expect.diagnostics` can't model a batched step with a
    // single-document format like sarif. The check output is parsed in the e2e run instead.
    ["check good file"] = testMaker.checkPass(goodWorkflow)
    // The patch comes from the fix in jactionlint's SARIF log, not from rerunning `--fix`.
    ["diff bad file"] = testMaker.diffPass(badWorkflow, goodWorkflow)
    ["fix bad file"] = testMaker.fixPass(badWorkflow, goodWorkflow)
  }
}
