import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Infrastructure"
  description = "OpenTofu formatter"
}
tofu = new Config.Step {
  glob = List("**/*.tf", "**/*.tfvars", "**/*.tftest.hcl")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("tofu", "fmt", "-check", "{{files}}") }
    effect = "read"
  }
  // `tofu fmt -` formats stdin. `fmt -diff` would need an external `diff`
  // program, which Windows often lacks.
  check_diff = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("hk", "util", "format-diff", "{{files}}", "--", "tofu", "fmt", "-")
    }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("tofu", "fmt", "{{files}}") }
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker { filename = "main.tf" }
    local const bad = "a   = 1\nbb = 2\n"
    local const good = "a  = 1\nbb = 2\n"
    ["check bad file"] = testMaker.checkFail(bad, 3)
    ["check good file"] = testMaker.checkPass(good)
    ["fix bad file"] = testMaker.fixPass(bad, good)
    ["fix good file"] = testMaker.fixPass(good, good)
  }
}
