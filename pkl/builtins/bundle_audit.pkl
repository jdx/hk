import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Ruby"
  description = "Dependency security audit"
}
bundle_audit = new Config.Step {
  glob = "**/Gemfile.lock"
  check = new Config.CommandSpec {
    command = "bundle-audit check {{ files }}"
    effect = "write"
  }
  fix = new Config.CommandSpec {
    command = "bundle-audit update"
    effect = "write"
  }
}
