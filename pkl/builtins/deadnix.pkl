import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Nix"
  description = "Scan Nix files for dead code"
}
deadnix = new Config.Step {
  glob = "**/*.nix"
  check = new Config.CommandSpec {
    command = "deadnix --fail {{ files }}"
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = "deadnix --edit {{ files }}"
    effect = "write"
  }
}
