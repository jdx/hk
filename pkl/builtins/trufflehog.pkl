import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

class TrufflehogStep extends Config.Step {
  // Select whether to scan the given files or every commit in the run's ref range (`pre-push`,
  // `--from-ref`, or `--pr`). `"commits"` catches a secret that a later commit removes.
  hidden scan: "files" | "commits" = "files"
  // No `types` filter in `commits` mode: a range whose commits add and remove a file has no
  // changed files, and hk would skip the step with "no files to run".
  types = if (scan == "files") List("text") else null
  requires_ref_range = scan == "commits"
  // --fail exits with code 183 when results are found.
  // --no-verification keeps scans offline: verification sends each candidate secret to its provider's API.
  // Reference: https://github.com/trufflesecurity/trufflehog#memo-usage
  check = new Config.CommandSpec {
    command = new Config.Command {
      argv =
        if (scan == "commits")
          List(
            "trufflehog",
            "git",
            "file://.",
            "--since-commit",
            "{{from_ref}}",
            "--branch",
            "{{to_ref}}",
            "--fail",
            "--no-update",
            "--no-verification",
          )
        else
          List(
            "trufflehog",
            "filesystem",
            "{{files}}",
            "--fail",
            "--no-update",
            "--no-verification",
          )
    }
    effect = "read"
  }
  tests =
    if (scan == "commits")
      helpers.commitScanTests("token = \"xoxb-65677559833-" + "9613778673399u\"", 183)
    else
      new Mapping<String, Config.StepTest> {
        local const testMaker = new helpers.TestMaker { filename = "foo.txt" }
        // Reference: https://github.com/trufflesecurity/trufflehog/blob/v3.99.7/pkg/detectors/slack/slack_test.go#L15
        // The token is split so secret-scanning push protection does not match the literal.
        ["check bad file"] =
          testMaker.checkFail("token = \"xoxb-65677559833-" + "9613778673399u\"", 183)
        ["check good file"] = testMaker.checkPass("message = foobar")
        ["check bad file after another path"] =
          (
            new helpers.TestMaker {
              filename = "secret.txt"
              files = List("clean.txt", "secret.txt")
              extra_files {
                ["clean.txt"] = "message = foobar"
              }
            }
          ).checkFail("token = \"xoxb-65677559833-" + "9613778673399u\"", 183)
        ["check ignore comment"] =
          testMaker.checkPass(
            "token = \"xoxb-65677559833-" + "9613778673399u\" # trufflehog:ignore",
          )
      }
}

@Builtins.meta {
  category = "Secrets"
  description = "Secret scanner that classifies 800+ credential types"
}
// Keep the exported type exactly Config.Step: pklr rejects a concrete subclass
// instance when it is inserted into Mapping<String, Config.Step>.
trufflehog = (new TrufflehogStep {}) as Config.Step
