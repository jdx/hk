import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Data Formats"
  description = "XML validator"
  homepage = "https://gitlab.gnome.org/GNOME/libxml2"
}
xmllint = new Config.Step {
  glob = "**/*.xml"
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("xmllint", "--noout", "{{files}}") }
    effect = "read"
  }
  // Findings are `path:line: parser error : message` followed by the source line and a caret
  diagnostic_format = "gcc"
}
