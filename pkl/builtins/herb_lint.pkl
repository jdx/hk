import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Ruby"
  description = "HTML+ERB linter"
  project_indicators {
    new { file = ".herb.yml" }
    new { file = "package.json"; contains = "@herb-tools/linter" }
  }
  mise_tools = List("npm:@herb-tools/linter")
}
herb_lint = new Config.Step {
  glob =
    List(
      "**/*.herb",
      "**/*.html.herb",
      "**/*.html",
      "**/*.rhtml",
      "**/*.html.erb",
      "**/*.html+*.erb",
      "**/*.turbo_stream.erb",
    )
  batch = true
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("herb-lint", "{{files}}") }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("herb-lint", "--fix", "{{files}}") }
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker {
      filename = "test file.html.erb"
      extra_files = new Mapping<String, String> {
        [".herb.yml"] =
          "framework: ruby\nlinter:\n  rules:\n    html-attribute-double-quotes:\n      severity: error\n    html-img-require-alt:\n      severity: error\n"
      }
    }
    local const bad = "<div class='card'><%= title %></div>\n"
    local const good = "<div class=\"card\"><%= title %></div>\n"
    ["check bad file"] = testMaker.checkFail(bad, 1)
    ["check good file"] = testMaker.checkPass(good)
    ["check herb file"] = testMaker.withFilename("test file.herb").checkFail(bad, 1)
    ["fix herb file"] = testMaker.withFilename("test file.herb").fixPass(bad, good)
    ["check html.herb file"] = testMaker.withFilename("test file.html.herb").checkFail(bad, 1)
    ["fix html.herb file"] = testMaker.withFilename("test file.html.herb").fixPass(bad, good)
    ["fix bad file"] = testMaker.fixPass(bad, good)
    ["fix good file"] = testMaker.fixPass(good, good)
    ["check missing alt"] = testMaker.checkFail("<img src=\"photo.png\">\n", 1)
    ["fix leaves missing alt"] =
      testMaker.fixFail("<img src=\"photo.png\">\n", "<img src=\"photo.png\">\n", 1)
  }
}
