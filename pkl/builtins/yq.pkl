import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Data Formats"
  description = "YAML processor"
}
yq = new Config.Step {
  glob = List("**/*.yaml", "**/*.yml")
  // The commands run one process per file, so split the files across jobs.
  batch = true
  // Label both sides with the file's path: an unlabeled `diff "$f" -` names
  // the new side `-`, which `git apply` cannot patch. Diff only output from a
  // successful run, since diffing a file yq cannot parse against empty output
  // would patch it to nothing.
  check_diff = new Config.CommandSpec {
    command =
      """
      failed=0
      broken=0
      trap 'rm -f "$out" "$patch"' EXIT
      trap 'exit 2' HUP INT TERM
      out=$(mktemp) && patch=$(mktemp) || exit 2
      for f in {{ files }}; do
      if yq -P "$f" > "$out"; then
      # hk runs this with `set -e`, so take diff's status through `||`.
      status=0
      diff -u -L "a/$f" -L "b/$f" "$f" "$out" >> "$patch" || status=$?
      case $status in
      0) ;;
      1) failed=1 ;;
      *) broken=1 ;;
      esac
      else
      broken=1
      fi
      done
      # When a file failed to parse or diff, print no patch: hk then runs the
      # fixer on every file, and the fixer reports the error.
      [ "$broken" = 1 ] && exit 1
      cat "$patch" || exit 2
      exit $failed
      """
    effect = "read"
  }
  fix = new Config.CommandSpec {
    // yq -i only rewrites the first file and merges every input into it,
    // so each file must be fixed separately.
    command =
      """
      failed=0
      for f in {{ files }}; do
      yq -iP "$f" || failed=1
      done
      exit $failed
      """
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker { filename = "test.yaml" }
    ["check bad file"] = testMaker.checkFail("foo:  bar", 1)
    ["check good file"] = testMaker.checkPass("foo: bar\n")
    ["fix bad file"] = testMaker.fixPass("foo:  bar", "foo: bar\n")
    ["fix good file"] = testMaker.fixPass("foo: bar\n", "foo: bar\n")
    ["fix multiple files"] {
      run = "fix"
      tmpdir = true
      write {
        ["a.yaml"] = "a:  1"
        ["b.yml"] = "b:  2"
      }
      expect {
        files {
          ["a.yaml"] = "a: 1\n"
          ["b.yml"] = "b: 2\n"
        }
      }
    }
  }
}
