import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Data Formats"
  description = "YAML processor"
}
yq = new Config.Step {
  glob = List("**/*.yaml", "**/*.yml")
  // The commands run one process per file, so split the files across jobs.
  batch = true
  // Label both sides with the file's path: an unlabeled `diff "$f" -` names
  // the new side `-`, which `git apply` cannot patch. Diff only output from a
  // successful run: a file yq cannot parse fails the check without a patch,
  // since diffing it against empty output would patch it to nothing.
  check_diff = new Config.CommandSpec {
    command =
      """
      failed=0
      out=$(mktemp) || exit 2
      for f in {{ files }}; do
      if yq -P "$f" > "$out"; then
      diff -u -L "a/$f" -L "b/$f" "$f" "$out" || failed=1
      else
      failed=1
      fi
      done
      rm -f "$out"
      exit $failed
      """
    effect = "read"
  }
  fix = new Config.CommandSpec {
    // yq -i only rewrites the first file and merges every input into it,
    // so each file must be fixed separately.
    command =
      """
      failed=0
      for f in {{ files }}; do
      yq -iP "$f" || failed=1
      done
      exit $failed
      """
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker { filename = "test.yaml" }
    ["check bad file"] = testMaker.checkFail("foo:  bar", 1)
    ["check good file"] = testMaker.checkPass("foo: bar\n")
    ["fix bad file"] = testMaker.fixPass("foo:  bar", "foo: bar\n")
    ["fix good file"] = testMaker.fixPass("foo: bar\n", "foo: bar\n")
    ["fix multiple files"] {
      run = "fix"
      tmpdir = true
      write {
        ["a.yaml"] = "a:  1"
        ["b.yml"] = "b:  2"
      }
      expect {
        files {
          ["a.yaml"] = "a: 1\n"
          ["b.yml"] = "b: 2\n"
        }
      }
    }
  }
}
