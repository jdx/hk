import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Go"
  description = "Go module maintenance"
}
gomod_tidy = new Config.Step {
  glob = "**/go.mod"
  check_diff = new Config.CommandSpec {
    command = "go mod tidy -diff"
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = "go mod tidy"
    effect = "write"
  }
}
