import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Special Purpose"
  description = "Flint's repository-aware link check (requires flint and lychee)"
}
lychee_extended = new Config.Step {
  types = List("text")
  stdin = "{{ files_list | join(sep='\n') }}"
  check = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("flint", "checker", "lychee", "--files-from", "-")
    }
    effect = "read"
  }
  tests {
    ["check markdown without links"] = new Config.StepTest {
      files = List("README.md")
      tmpdir = true
      write = new Mapping<String, String> {
        ["README.md"] = "# Notes\n"
        ["lychee.toml"] = "max_concurrency = 1\n"
        [".github/config/lychee.toml"] = "max_concurrency = 1\n"
      }
      before = "git init . && git add README.md"
      env = new Mapping<String, String> {
        ["GITHUB_TOKEN"] = "test-token"
        ["PR_HEAD_REPO"] = "jdx/hk"
      }
      expect = new Config.StepTestExpect {
        code = 0
        files = new Mapping<String, String> {
          ["README.md"] = "# Notes\n"
        }
      }
    }
  }
}
