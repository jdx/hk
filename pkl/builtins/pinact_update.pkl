import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Infrastructure"
  description = "Pin GitHub Actions to update actions to latest versions"
}
class PinactUpdateStep extends Config.Step {
  hidden version: "3" | "4" = "4"
  glob = List(".github/workflows/*", "**/action.*")
  types = List("yaml")
  // `verify-comment` verifies pairs of commit SHA and version comments are correct
  check_diff = new Config.CommandSpec {
    command = new Config.Command {
      argv =
        if (version == "3")
          List("pinact", "run", "--update", "--verify", "--check", "{{files}}")
        else
          List(
            "pinact",
            "run",
            "--update",
            "--verify-comment",
            "--check",
            "{{files}}",
          )
    }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command {
      argv =
        if (version == "3")
          List("pinact", "run", "--update", "--verify", "{{files}}")
        else
          List("pinact", "run", "--update", "--verify-comment", "{{files}}")
    }
    effect = "write"
  }
  // Tests removed: they check against live GitHub Action versions, making them flaky
}

const pinact_update = (new PinactUpdateStep {}) as Config.Step
