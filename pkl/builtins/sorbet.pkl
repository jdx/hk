import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Ruby"
  description = "Type checker for Ruby"
  project_indicators {
    new { file = "sorbet/config" }
  }
}
sorbet = new Config.Step {
  types = List("ruby")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("srb", "tc", "{{files}}") }
    effect = "write"
  }
  // Findings are `path:line: message https://srb.help/NNNN` plus indented context; hk ignores the `Errors: N` summary
  diagnostic_format = "gcc"
}
