import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Ruby"
  description = "Type checker for Ruby"
}
sorbet = new Config.Step {
  types = List("ruby")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("srb", "tc", "{{files}}") }
    effect = "write"
  }
}
