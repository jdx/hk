import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Go"
  description = "Go code vetting"
}
go_vet = new Config.Step {
  glob = "**/*.go"
  workspace_indicator = "go.mod"
  dir = "{{workspace}}"
  check = new Config.CommandSpec {
    command = "go vet ./..."
    effect = "write"
  }
  // Analyzer findings are `path:line:column: message`; a package that does not compile
  // prints `# pkg` headers and a `vet: ` prefix, which the parser ignores
  diagnostic_format = "gcc"
  tests {
    ["check good file"] {
      run = "check"
      tmpdir = true
      write = new Mapping<String, String> {
        ["go.mod"] =
          """
            module example.com/test

            go 1.21
          """
        ["main.go"] =
          """
            package main

            func main() {}
          """
      }
      expect { code = 0 }
    }
    ["check bad file"] {
      run = "check"
      tmpdir = true
      write = new Mapping<String, String> {
        ["go.mod"] =
          """
            module example.com/test

            go 1.21
          """
        ["main.go"] =
          """
            package main

            import "fmt"

            func main() {}
          """
      }
      expect { code = 1 }
    }
    ["check bad file reports diagnostics"] {
      run = "check"
      tmpdir = true
      write = new Mapping<String, String> {
        ["go.mod"] =
          """
            module example.com/test

            go 1.21
          """
        ["main.go"] =
          """
            package main

            import "fmt"

            func main() {}
          """
      }
      expect {
        code = 1
        diagnostics {
          new Config.StepTestDiagnostic {
            path = "main.go"
            line = 3
            column = 8
            severity = "error"
            message = "\"fmt\" imported and not used"
          }
        }
      }
    }
    ["check analyzer finding reports diagnostics"] {
      run = "check"
      tmpdir = true
      write = new Mapping<String, String> {
        ["go.mod"] =
          """
            module example.com/test

            go 1.21
          """
        ["main.go"] =
          """
            package main

            import "fmt"

            func main() {
              fmt.Printf("%d\\n", "x")
            }
          """
      }
      expect {
        code = 1
        diagnostics {
          new Config.StepTestDiagnostic {
            path = "main.go"
            line = 6
            column = 15
            severity = "error"
            message = "format %d has arg \"x\" of wrong type string"
          }
        }
      }
    }
    ["check multi-package"] {
      run = "check"
      tmpdir = true
      write = new Mapping<String, String> {
        ["go.mod"] =
          """
            module example.com/test

            go 1.21
          """
        ["main.go"] =
          """
            package main

            func main() {}
          """
        ["pkg/a/a.go"] =
          """
            package a

            func Hello() string { return "hello" }
          """
      }
      expect { code = 0 }
    }
  }
}
