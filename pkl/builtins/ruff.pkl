import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Python"
  description = "Fast Python linter"
  project_indicators {
    new { file = "pyproject.toml" }
    new { file = "requirements.txt" }
  }
  mise_tools = List("ruff")
}
ruff = new Config.Step {
  types = List("python")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("ruff", "check", "--force-exclude", "{{files}}") }
    effect = "write"
  }
  // `ruff check --diff` only reports what it can fix, and exits 0 when that is
  // nothing, even if other issues remain. So when there is nothing to fix, the
  // check runs too: remaining issues fail without a patch, and hk runs the
  // fixer, which reports them. After a patch applies, `check_after_diff`
  // reports what it left.
  // ruff 0.12 and later print `F401 [*] message` / ` --> path:line:col`, the same shape as rustc's
  diagnostic_format = "rustc"
  check_diff = new Config.CommandSpec {
    command =
      "ruff check --force-exclude --diff --exit-non-zero-on-fix {{ files }} && ruff check --force-exclude {{ files }}"
    effect = "write"
  }
  check_after_diff = true
  fix = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("ruff", "check", "--force-exclude", "--fix", "{{files}}")
    }
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker {
      filename = "test.py"
      extra_files = new Mapping<String, String> {
        ["ruff.toml"] = "exclude = [\"excluded.py\"]\n"
      }
    }
    local const before = "import sys\nprint('hello')\n"
    local const after = "print('hello')\n"
    ["check bad file"] = testMaker.checkFail(before, 1)
    ["check good file"] = testMaker.checkPass(after)
    ["fix bad file"] = testMaker.fixPass(before, after)
    ["diff bad file"] = testMaker.diffPass(before, after)
    ["fix good file"] = testMaker.fixPass(after, after)
    ["check respects config exclude"] = testMaker.withFilename("excluded.py").checkPass(before)
    ["fix respects config exclude"] = testMaker.withFilename("excluded.py").fixPass(before, before)
    ["diff respects config exclude"] =
      testMaker.withFilename("excluded.py").diffPass(before, before)
    ["check bad file reports diagnostics"] =
      testMaker.checkDiagnostics(
        before,
        1,
        List(new Config.StepTestDiagnostic {
          path = "test.py"
          line = 1
          column = 8
          severity = "error"
          rule = "F401"
          message = "`sys` imported but unused"
        }),
      )
  }
}
