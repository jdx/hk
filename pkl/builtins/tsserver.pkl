import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "JavaScript/TypeScript"
  description = "TypeScript language server diagnostics"
  mise_tools = List("npm:tsc-files", "npm:typescript")
}
tsserver = new Config.Step {
  glob = List("**/*.ts", "**/*.tsx")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("tsc-files", "--noEmit", "{{files}}") }
    effect = "write"
  }
  // tsc-files passes tsc's `path(line,col): error TS2322: message` output through
  diagnostic_format = "tsc"
}
