import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Python"
  description = "Opinionated Python formatter"
  project_indicators {
    new { file = "pyproject.toml"; contains = "black" }
  }
}
black = new Config.Step {
  glob = List("**/*.py")
  // Black skips its cache when `--diff` is set, so there is no `check_diff`:
  // on a large, already formatted project `black --check --diff` takes about
  // ten times as long as `black --check`, and hk would run it before every fix.
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("black", "--check", "{{files}}") }
    effect = "read"
  }
  // Lists the files that `black --check` reports on stderr, including files it
  // cannot format so that the fixer reports their errors.
  check_list_files = new Config.CommandSpec {
    command =
      #"""
      out=$(black --check {{ files }} 2>&1) && exit 0
      status=$?
      printf '%s\n' "$out" | while IFS= read -r line; do
      case "$line" in
      "would reformat "*) printf '%s\n' "${line#would reformat }" ;;
      "error: cannot format "*) line=${line#error: cannot format }; printf '%s\n' "${line%%: *}" ;;
      esac
      done
      exit $status
      """#
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("black", "{{files}}") }
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker { filename = "test.py" }
    local const before = "x=1"
    local const after = "x = 1\n"
    ["check bad file"] = testMaker.checkFail(before, 1)
    ["check good file"] = testMaker.checkPass(after)
    ["fix bad file"] = testMaker.fixPass(before, after)
    ["fix good file"] = testMaker.fixPass(after, after)
  }
}
