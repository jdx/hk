import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Special Purpose"
  description = "Ensure files end with newline"
}
newlines = new Config.Step {
  types = List("text")
  check_diff = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("hk", "util", "end-of-file-fixer", "--diff", "{{files}}")
    }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("hk", "util", "end-of-file-fixer", "--fix", "{{files}}")
    }
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker {}
    ["check bad file"] = testMaker.checkFail("content", 1)
    ["check good file"] = testMaker.checkPass("content\n")
    ["fix bad file"] = testMaker.fixPass("content", "content\n")
    ["diff bad file"] = testMaker.diffPass("content", "content\n")
    ["fix good file"] = testMaker.fixPass("content\n", "content\n")
    ["check good CRLF file"] = testMaker.checkPass("content\r\n")
    ["check CRLF file with a blank line at the end"] = testMaker.checkFail("content\r\n\r\n", 1)
    ["fix CRLF file without final newline appends CRLF"] =
      testMaker.fixPass("one\r\ntwo", "one\r\ntwo\r\n")
    ["diff CRLF file without final newline appends CRLF"] =
      testMaker.diffPass("one\r\ntwo", "one\r\ntwo\r\n")
    ["fix CRLF file removes trailing blank CRLF lines"] =
      testMaker.fixPass("one\r\ntwo\r\n\r\n\r\n", "one\r\ntwo\r\n")
    ["diff CRLF file removes trailing blank CRLF lines"] =
      testMaker.diffPass("one\r\ntwo\r\n\r\n", "one\r\ntwo\r\n")
  }
}
