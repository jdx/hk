import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "PHP"
  description = "PHP static analyzer"
  project_indicators {
    new { file = "phpstan.neon" }
    new { file = "phpstan.neon.dist" }
    new { file = "phpstan.dist.neon" }
    new { file = "composer.json"; contains = "phpstan" }
  }
}
phpstan = new Config.Step {
  glob = "**/*.php"
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("phpstan", "analyse", "--no-progress", "{{files}}") }
    effect = "read"
  }
  tests {
    local const testMaker = new helpers.TestMaker { filename = "test.php" }
    ["check bad file"] =
      testMaker.checkFail(
        """
        <?php

        undefined_function();

        """,
        1,
      )
    ["check good file"] =
      testMaker.checkPass(
        """
        <?php

        function add(int $a, int $b): int
        {
            return $a + $b;
        }

        echo add(1, 2);

        """,
      )
  }
}
