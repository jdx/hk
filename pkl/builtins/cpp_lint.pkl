import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Other Languages"
  description = "C++ style checker"
}
cpp_lint = new Config.Step {
  glob =
    List("**/*.c", "**/*.h", "**/*.cpp", "**/*.hpp", "**/*.cc", "**/*.hh", "**/*.cxx", "**/*.hxx")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("cpplint", "{{files}}") }
    effect = "read"
  }
}
