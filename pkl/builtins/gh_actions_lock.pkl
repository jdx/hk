import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

/// Keeps `.github/workflows/actions.lock`, the lockfile of GitHub's
/// [gh-actions-lock](https://github.com/github/gh-actions-lock), in step with the workflows.
///
/// `check` runs `gh-actions-lock --verify-local`, which is offline and needs no token: it fails
/// when a workflow uses an action the lockfile does not pin. `fix` runs that check first and
/// does nothing when it passes. Otherwise it runs `gh-actions-lock`, which resolves the missing
/// pins through the GitHub API (with `GH_TOKEN` or `GITHUB_TOKEN` when set, else anonymously,
/// at 60 requests an hour) and writes the lockfile. When it pins a workflow for the first time,
/// it also narrows a partial ref such as `actions/checkout@v4` in the workflow to the full tag
/// it locked, such as `@v4.4.0`, so the step stages the workflows as well as the lockfile.
///
/// gh-actions-lock only prunes the entry of a deleted workflow when it resolves the lockfile,
/// and `--verify-local` passes while such an entry remains, so this step leaves it until the
/// next fix that has to call GitHub, or until you run `gh-actions-lock` yourself.
@Builtins.meta {
  category = "Infrastructure"
  description = "Pin every action the workflows use in GitHub's Actions lockfile (gh-actions-lock)"
  project_indicators {
    new { file = ".github/workflows/actions.lock" }
  }
  mise_tools = List("aqua:github/gh-actions-lock")
}
const gh_actions_lock = new Config.Step {
  // Local actions are part of the lockfile too: their actions are recorded under each
  // workflow that runs them.
  glob =
    List(
      ".github/workflows/*.y*ml",
      ".github/workflows/actions.lock",
      ".github/actions/**/action.y*ml",
    )
  // gh-actions-lock always reads every workflow, so it runs once for the whole repository.
  stage = List(".github/workflows/*.y*ml", ".github/workflows/actions.lock")
  check = new Config.CommandSpec {
    command = "gh-actions-lock --verify-local"
    effect = "read"
  }
  // gh-actions-lock calls GitHub on every run, even when the lockfile is complete, and exits 0
  // without writing anything when GitHub cannot be reached. The offline check before it
  // skips the call when nothing is missing, and the one after it fails the fix when nothing
  // was written.
  fix = new Config.CommandSpec {
    command =
      """
      gh-actions-lock --verify-local >/dev/null 2>&1 && exit 0
      gh-actions-lock --no-interactive || exit
      gh-actions-lock --verify-local
      """
    effect = "write"
  }
  tests {
    local const workflow =
      """
      name: ci
      on: push
      jobs:
        test:
          runs-on: ubuntu-latest
          steps:
            - uses: actions/checkout@v4.2.2

      """
    local const lockfile =
      """
      # This file is machine-generated by `gh actions-lock`.
      # Do not edit by hand; run `gh actions-lock` to update.
      # Docs: https://gh.io/actions-lockfile
      version: 'v0.0.3'
      workflows:
          '.github/workflows/ci.yml':
              - 'actions/checkout@v4.2.2'
      dependencies:
          'actions/checkout@v4.2.2':
              ref: 'v4.2.2'
              commit: 'sha1-11bd71901bbe5b1630ceea73d27597364c9af683'
              owner_id: 44036562
              repo_id: 197814629

      """
    local const testMaker = new helpers.TestMaker {
      filename = ".github/workflows/actions.lock"
      before = "git init --quiet"
      extra_files = new Mapping<String, String> {
        [".github/workflows/ci.yml"] = workflow
      }
    }
    // The lockfile records only the action of another workflow
    local const otherWorkflowOnly =
      """
      version: 'v0.0.3'
      workflows:
          '.github/workflows/other.yml':
              - 'actions/checkout@v4.2.2'
      dependencies:
          'actions/checkout@v4.2.2':
              ref: 'v4.2.2'
              commit: 'sha1-11bd71901bbe5b1630ceea73d27597364c9af683'
              owner_id: 44036562
              repo_id: 197814629

      """
    ["check complete lockfile"] = testMaker.checkPass(lockfile)
    ["check workflow missing from lockfile"] = testMaker.checkFail(otherWorkflowOnly, 1)
    // Offline: the check passes, so the fix never calls GitHub
    ["fix complete lockfile"] = testMaker.fixPass(lockfile, lockfile)
    // Calls the GitHub API. A full semver tag is not narrowed, so the workflow is unchanged.
    ["fix creates missing lockfile"] = new Config.StepTest {
      run = "fix"
      tmpdir = true
      before = "git init --quiet"
      write = new Mapping<String, String> {
        [".github/workflows/ci.yml"] = workflow
      }
      expect {
        files {
          [".github/workflows/actions.lock"] = lockfile
          [".github/workflows/ci.yml"] = workflow
        }
      }
    }
  }
}
