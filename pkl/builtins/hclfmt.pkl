import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Infrastructure"
  description = "Hashicorp's hclfmt"
  mise_tools = List("go:github.com/hashicorp/hcl/v2/cmd/hclfmt")
}
hclfmt = new Config.Step {
  glob = "**/*.hcl"
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("hclfmt", "-w", "{{files}}") }
    effect = "write"
  }
}
