import "../Builtins.pkl"
import "../Config.pkl"
import "./test/helpers.pkl"

@Builtins.meta {
  category = "Other Languages"
  description = "Kotlin linter and formatter"
}
ktlint = new Config.Step {
  glob = "**/*.kt"
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("ktlint", "{{files}}") }
    effect = "read"
  }
  // Findings are `path:line:column: message (rule)`; hk ignores ktlint's WARN log line and summary
  diagnostic_format = "gcc"
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("ktlint", "-F", "{{files}}") }
    effect = "write"
  }
  tests {
    local const testMaker = new helpers.TestMaker { filename = "Test.kt" }
    ["check bad file"] = testMaker.checkFail("const val FOO_1  =  \"foo1\"", 1)
    // ktlint prints absolute paths, so this test does not assert one
    ["check bad file reports diagnostics"] =
      testMaker.checkDiagnostics(
        "const val FOO_1  =  \"foo1\"",
        1,
        List(
          new Config.StepTestDiagnostic {
            line = 1
            column = 17
            severity = "error"
            message = "Unnecessary long whitespace (standard:no-multi-spaces)"
          },
          new Config.StepTestDiagnostic {
            line = 1
            column = 26
            severity = "error"
            message = "File must end with a newline (\\n) (standard:final-newline)"
          },
        ),
      )
    ["check good file"] = testMaker.checkPass("const val FOO_1 = \"foo1\"\n")
    ["fix bad file"] =
      testMaker.fixPass("const val FOO_1  =  \"foo1\"", "const val FOO_1 = \"foo1\"\n")
    ["fix good file"] =
      testMaker.fixPass("const val FOO_1 = \"foo1\"\n", "const val FOO_1 = \"foo1\"\n")
    ["fixes formatting but not unfixable lint error"] =
      testMaker.fixFail("const val fooBar  =  \"FOO-BAR\"", "const val fooBar = \"FOO-BAR\"\n", 1)
  }
}
