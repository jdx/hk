import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = ".NET"
  description = "Format C# and Visual Basic with the .NET SDK"
  project_indicators {
    new { glob = "*.csproj" }
    new { glob = "*.vbproj" }
    new { glob = "*.sln" }
    new { glob = "*.slnx" }
  }
}
// Requires the .NET SDK (6+). Uses dotnet's project/solution discovery in the
// working directory. Set `dir` for a nested solution or standalone project;
// use separate steps for independent directories. Ambiguous roots fail rather
// than silently selecting a project. hk rebases {{files}} when dir is set.
// dotnet format can restore, compile, and run project analyzers: trusted code only.
dotnet_format = new Config.Step {
  glob = List("**/*.cs", "**/*.vb")
  // Restore/build can touch shared project state beyond the selected source files.
  // Do not batch or allow concurrent steps while this command is running.
  exclusive = true
  check = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("dotnet", "format", "--verify-no-changes", "--include", "{{files}}")
    }
    // Verification preserves source, but implicit restore may write obj/.
    effect = "write"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("dotnet", "format", "--include", "{{files}}")
    }
    effect = "write"
  }
}
