import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Ruby"
  description = "Security scanner for Rails"
}
brakeman = new Config.Step {
  types = List("ruby")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("brakeman", "-q", "-w2", "{{files}}") }
    effect = "read"
  }
}
