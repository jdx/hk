import "../Builtins.pkl"
import "../Config.pkl"

@Builtins.meta {
  category = "Ruby"
  description = "Security scanner for Rails"
  project_indicators {
    new { file = "config/brakeman.yml" }
    new { file = "Gemfile"; contains = "brakeman" }
  }
}
brakeman = new Config.Step {
  types = List("ruby")
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("brakeman", "-q", "-w2", "{{files}}") }
    effect = "read"
  }
}
