/// oxfmt and ESLint, with TypeScript checking enabled by the types profile.
amends "hk:/Config.pkl"

import "hk:/Builtins.pkl"

steps {
  ["eslint"] = Builtins.eslint
  ["oxfmt"] = (Builtins.oxfmt) {
    // Choose a stable order when both tools can format JavaScript.
    depends = "eslint"
  }
  ["tsc"] = (Builtins.tsc) {
    profiles = List("types")
  }
}
