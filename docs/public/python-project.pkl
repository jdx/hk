/// Ruff linting and formatting, with optional mypy checks.
amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

steps {
  ["ruff"] = Builtins.ruff
  ["ruff-format"] = (Builtins.ruff_format) {
    depends = "ruff"
  }
  ["mypy"] = (Builtins.mypy) {
    profiles = List("types")
  }
}
