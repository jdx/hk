{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "tsc -p .vitepress/theme/showreel && node .vitepress/theme/showreel/test/run.mjs && node --test .vitepress/social-images.test.mjs && vitepress build && node .vitepress/check-social-images.mjs .vitepress/dist",
    "docs:preview": "vitepress preview",
    "eslint": "eslint",
    "showreel:video": "node .vitepress/showreel-video.mjs",
    "test:showreel": "node .vitepress/theme/showreel/test/run.mjs",
    "typecheck": "tsc -p .vitepress/theme/showreel"
  },
  "dependencies": {
    "eslint": "^10.0.0",
    "vitepress": "^1.6.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26",
    "esbuild": "^0.21.5",
    "globals": "^17.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "linux",
        "darwin"
      ],
      "cpu": [
        "x64",
        "arm64"
      ],
      "libc": [
        "glibc"
      ]
    }
  }
}
