amends "../../pkl/Config.pkl"

// A pre-commit hook that stashes unstaged changes, runs a fixer that rewrites
// the staged files, and stages and restores the result: the everyday
// `git commit` path. fixture.sh copies this file into the benchmark repository.
hooks = new {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = new {
      ["fix"] {
        glob = "**/*.txt"
        fix = "for f in {{files}}; do echo fixed >> \"$f\"; done"
      }
    }
  }
}
